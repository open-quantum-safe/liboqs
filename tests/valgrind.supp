# SPDX-License-Identifier: MIT
#
# Valgrind suppressions for tests/test_leaks.py

# On x86_64, glibc's __memcpy_chk is an alias of __memmove_chk
# Valgrind versions before 3.20 apply its memcpy overlap check to both. 
# With _FORTIFY_SOURCE, SQIsign's in-place ibz_copy (a memmove with dst == src)
# is then reported as an overlapping memcpy. 
# See https://bugs.kde.org/show_bug.cgi?id=402833
{
   sqisign-ibz-memmove-chk-valgrind-bug-402833
   Memcheck:Overlap
   fun:__memcpy_chk
   fun:sqisign_*_ibz_*
}
