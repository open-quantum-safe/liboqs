#!/bin/bash

rv=0

if ! command -v rumdl >/dev/null 2>&1; then
  echo "Error: rumdl not found. Please install using requirements-linter.txt" >&2
  exit 1
fi

rumdl check --config .rumdl.toml --respect-gitignore --exclude "build,**/build" . || rv=1

# Check formatting of staged C sources (files in .clang-format-ignore are skipped)
c_files=()
while IFS= read -r f; do
  c_files+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.[ch]' 'tests/*.[ch]')
if [ ${#c_files[@]} -gt 0 ] && ! ./scripts/format_code.sh --check "${c_files[@]}"; then
  echo "Error: staged C files are not formatted. Run ./scripts/format_code.sh and stage the changes." >&2
  rv=1
fi

exit $rv
